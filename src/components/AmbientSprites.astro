---
/** Decorative hero edges: fireflies and a wandering boar. Hidden for reduced motion. */
import LoopClip from './LoopClip.astro';
const flies = [
  { x: 6, y: 22, d: 0 }, { x: 14, y: 58, d: 1.3 }, { x: 22, y: 36, d: 2.1 }, { x: 78, y: 28, d: 0.7 },
  { x: 88, y: 64, d: 1.9 }, { x: 94, y: 40, d: 2.6 }, { x: 70, y: 70, d: 3.2 }, { x: 31, y: 74, d: 0.4 },
];
---
<div class="ambient" aria-hidden="true">
  {flies.map((f) => <i class="fly" style={`left:${f.x}%;top:${f.y}%;animation-delay:${f.d}s`}></i>)}
  <div class="walker"><LoopClip src="art/sprites/boar-walk.png" frameW={24} frameH={24} frames={8} row={1} scale={3} ms={110} label="" /></div>
</div>
<style>
  .ambient { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  .fly { position: absolute; width: 4px; height: 4px; background: var(--rr-ember-hover); box-shadow: 0 0 0 2px rgba(225, 168, 69, 0.25); animation: blink 3.2s steps(1) infinite; }
  @keyframes blink { 0% { opacity: 0; } 20% { opacity: 1; } 45% { opacity: 1; transform: translate(4px, -4px); } 55% { opacity: 0; } 100% { opacity: 0; } }
  .walker { position: absolute; bottom: 8px; left: 0; animation: walk 38s linear infinite; }
  @keyframes walk { from { transform: translateX(-100px); } to { transform: translateX(100vw); } }
  @media (max-width: 720px) { .walker { display: none; } }
  @media (prefers-reduced-motion: reduce) { .ambient { display: none; } }
</style>
