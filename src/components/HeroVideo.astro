---
/** YouTube click-to-load facade (youtube-nocookie, nothing loads before the click); key art when there is no trailer. */
import PixelImage from './PixelImage.astro';
import { config } from '../lib/site';
const id = config.trailer_youtube_id;
---
{id ? (
  <div class="video" data-yt={id}>
    <button type="button" class="facade" aria-label="Play the trailer">
      <PixelImage src="art/scenes/meadow-golden-hour.png" w={384} h={288} alt="" scale={3} sm={1} crop loading="eager" />
      <span class="play" aria-hidden="true">▶</span>
    </button>
  </div>
) : (
  <div class="art">
    <PixelImage src="art/keyart/keyart.png" w={600} h={400} art={4} scale={5} sm={2} alt="Key art: a bearded survivor with a club, a Mirebound, a white Moccus boar, a Salvager robot and a boar piglet, in voxel pixel art." loading="eager" />
  </div>
)}
<style>
  .video { position: relative; aspect-ratio: 16 / 9; width: min(100%, 960px); margin-inline: auto; border: var(--rr-border); background: #000; }
  .facade { all: unset; cursor: pointer; display: block; width: 100%; height: 100%; position: relative; overflow: hidden; }
  .play { position: absolute; inset: 0; display: grid; place-items: center; font-size: 3rem; color: var(--rr-ember); text-shadow: 0 3px 0 var(--rr-ember-shadow); }
  .art { filter: drop-shadow(0 12px 0 rgba(0, 0, 0, 0.35)); }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-yt]').forEach((box) => {
    box.querySelector('button')?.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = `https://www.youtube-nocookie.com/embed/${box.dataset.yt}?autoplay=1&rel=0`;
      f.allow = 'autoplay; encrypted-media; picture-in-picture';
      f.allowFullscreen = true;
      f.title = 'Trailer';
      f.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0';
      box.replaceChildren(f);
    });
  });
</script>
