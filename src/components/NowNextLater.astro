---
import { roadmap } from '../lib/site';
const cols = [roadmap.columns.now, roadmap.columns.next, roadmap.columns.later];
---
<div class="cols">
  {cols.map((c) => (
    <section class="col">
      <h3>{c.title}</h3>
      <ul>{c.items.map((it) => <li>{it}</li>)}</ul>
    </section>
  ))}
</div>
<style>
  .cols { display: grid; gap: var(--rr-space-4); grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); }
  .col { background: var(--rr-panel); border: var(--rr-border); border-radius: var(--rr-radius); padding: var(--rr-space-5); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08); }
  h3 { color: var(--rr-ember); margin-bottom: var(--rr-space-3); }
  ul { margin: 0; padding-left: 1.1em; display: grid; gap: var(--rr-space-2); }
  li::marker { color: var(--rr-moss); }
</style>
