---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import RoadmapLadder from '../components/RoadmapLadder.astro';
import NowNextLater from '../components/NowNextLater.astro';
---
<Base title="Roadmap" description="The honest release ladder of The Rewilding Rite, from prototype to 1.0, and what we are working on now.">
  <div class="rr-wrap rr-section">
    <SectionHeading level="h1" eyebrow="Roadmap" title="The road to 1.0" lede="Every build has a different job. We climb one rung at a time and tell you which one we are on. Dates are deliberately absent: we name windows, not promises." />
    <RoadmapLadder />
  </div>
  <div class="rr-wrap rr-section">
    <SectionHeading title="Now, next, later" />
    <NowNextLater />
  </div>
</Base>
